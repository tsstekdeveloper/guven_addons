<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_guven_kaynak_source_list" model="ir.ui.view">
        <field name="name">guven.kaynak.source.list</field>
        <field name="model">guven.kaynak.source</field>
        <field name="arch" type="xml">
            <list string="Kaynak Sistem Bağlantıları" create="0" delete="0"
                  decoration-danger="has_error">
                <field name="name"/>
                <field name="system"/>
                <field name="host"/>
                <field name="last_run_at"/>
                <field name="last_success_at"/>
                <field name="last_record_count"/>
                <field name="has_error"/>
            </list>
        </field>
    </record>

    <record id="view_guven_kaynak_source_form" model="ir.ui.view">
        <field name="name">guven.kaynak.source.form</field>
        <field name="model">guven.kaynak.source</field>
        <field name="arch" type="xml">
            <form string="Kaynak Sistem Bağlantısı" create="0" delete="0">
                <header>
                    <button name="action_test_connection" type="object" string="Bağlantıyı Test Et"
                            class="btn-primary"/>
                    <button name="action_run_comparison" type="object" string="Karşılaştırmayı Şimdi Çalıştır"
                            confirm="Tur en fazla 5 dakika sürer ve iki kaynağı da okur. Devam edilsin mi?"/>
                    <button name="action_reset_baseline" type="object" string="Küçülme Tabanını Sıfırla"
                            invisible="system != 'cerebrum'"
                            confirm="Bir sonraki Cerebrum okuması küçülme denetimi yapılmadan yazılacak. Devam edilsin mi?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Bağlantı">
                            <field name="system"/>
                            <field name="host"/>
                            <field name="port"/>
                            <field name="database"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                        </group>
                        <group string="Son Durum">
                            <field name="last_run_at"/>
                            <field name="last_success_at"/>
                            <field name="has_error"/>
                            <field name="last_record_count"/>
                            <field name="baseline_record_count" invisible="system != 'cerebrum'"/>
                            <field name="unknown_types" invisible="system != 'pusula'"/>
                        </group>
                    </group>
                    <group string="Son Hata" invisible="not last_error">
                        <field name="last_error" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_guven_kaynak_source" model="ir.actions.act_window">
        <field name="name">Kaynak Sistem Bağlantıları</field>
        <field name="res_model">guven.kaynak.source</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
