<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_kaynak_karsilastirma" model="ir.ui.view">
        <field name="name">res.company.form.inherit.kaynak.karsilastirma</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <page name="general_info" position="after">
                <page string="Kaynak Sistemler" name="kaynak_sistemler" groups="base.group_system">
                    <group string="Pusula ve Cerebrum Kapsamı">
                        <field name="kaynak_pusula_branch_ids" placeholder="örn. 10, 11"/>
                        <field name="kaynak_cerebrum_company_ids" placeholder="örn. 1, 8"/>
                    </group>
                    <div class="text-muted">
                        Bu şirketin geçerli izibiz faturaları yalnızca burada listelenen Pusula şubelerinde
                        ve Cerebrum şirketlerinde aranır. Kimlik numaraları iki sistemde farklı şirketleri
                        gösterebildiği için eşleme elle tutulur. İki alan da boşsa şirket karşılaştırmaya alınmaz.
                    </div>
                </page>
            </page>
        </field>
    </record>
</odoo>
